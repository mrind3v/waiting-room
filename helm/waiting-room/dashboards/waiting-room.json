{
  "uid": "waiting-room",
  "title": "Waiting Room",
  "tags": ["waiting-room"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests / s by handler",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (handler) (rate(http_requests_total{namespace=\"waiting-room\", handler!~\"/metrics|/health|/ready\"}[1m]))", "legendFormat": "{{handler}}"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{namespace=\"waiting-room\", handler!~\"/metrics|/health|/ready\"}[5m])))", "legendFormat": "{{handler}}"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "5xx error ratio",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{namespace=\"waiting-room\", status=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"waiting-room\"}[5m])), 1e-9)", "legendFormat": "5xx"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Appointment transitions / min by status",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (to_status) (increase(waitingroom_appointment_transitions_total[1m]))", "legendFormat": "{{to_status}}"}]
    },
    {
      "id": 5, "type": "stat", "title": "Double-booking conflicts (409s)",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(waitingroom_booking_conflicts_total)"}]
    },
    {
      "id": 6, "type": "timeseries", "title": "Backend replicas (HPA)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "kube_deployment_status_replicas{namespace=\"waiting-room\", deployment=~\".*-backend\"}", "legendFormat": "replicas"}]
    },
    {
      "id": 7, "type": "timeseries", "title": "Backend CPU usage (cores)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"waiting-room\", container=\"backend\"}[1m]))", "legendFormat": "{{pod}}"}]
    }
  ]
}
